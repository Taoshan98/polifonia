{
  "app-id": "io.github.taoshan98.Polifonia",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "polifonia",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0",
    "--filesystem=xdg-config/polifonia:create",
    "--device=all"
  ],
  "modules": [
    {
      "name": "polifonia",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} .",
        "install -Dm644 io.github.taoshan98.Polifonia.desktop ${FLATPAK_DEST}/share/applications/io.github.taoshan98.Polifonia.desktop",
        "install -Dm644 assets/io.github.taoshan98.Polifonia.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/io.github.taoshan98.Polifonia.svg",
        "install -Dm644 assets/io.github.taoshan98.Polifonia-symbolic.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/io.github.taoshan98.Polifonia-symbolic.svg",
        "install -Dm644 io.github.taoshan98.Polifonia.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.taoshan98.Polifonia.metainfo.xml"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/Taoshan98/polifonia/archive/refs/tags/v1.0.6.tar.gz",
          "sha256": "4aacc3a757d6cad7080f84c244b88ab016fce2a842299f4c25f3f9a1ebfb36be"
        }
      ]
    }
  ]
}
