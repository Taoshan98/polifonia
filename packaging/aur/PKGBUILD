# Maintainer: Polifonia Contributors <info@polifonia.io>
pkgname=polifonia
pkgver=2.0.0
pkgrel=1
pkgdesc="Native Rust Multi-Speaker & Multi-Monitor Audio Unison Studio for Linux (PipeWire)"
arch=('x86_64' 'aarch64')
url="https://github.com/Taoshan98/polifonia"
license=('MIT')
depends=('dbus' 'gcc-libs' 'glibc' 'pipewire' 'pipewire-pulse' 'wireplumber' 'libpulse' 'hicolor-icon-theme')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo build --release --locked --target-dir=target
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --locked --target-dir=target
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/polifonia "$pkgdir/usr/bin/polifonia"
    install -Dm644 io.github.taoshan98.Polifonia.desktop "$pkgdir/usr/share/applications/io.github.taoshan98.Polifonia.desktop"
    install -Dm644 assets/io.github.taoshan98.Polifonia.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.taoshan98.Polifonia.svg"
    install -Dm644 assets/io.github.taoshan98.Polifonia-symbolic.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.taoshan98.Polifonia-symbolic.svg"
    install -Dm644 assets/io.github.taoshan98.Polifonia.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/polifonia-studio-color.svg"
    install -Dm644 io.github.taoshan98.Polifonia.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.taoshan98.Polifonia.metainfo.xml"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
